# Copie ce fichier en ".env" et remplis les valeurs réelles.
# Ne jamais committer le fichier ".env" (il doit être dans .gitignore).

# --- Base de données ---
# Fournie automatiquement par Railway/Render une fois le PostgreSQL créé
DATABASE_URL="postgresql://user:password@host:5432/streaming_db"

# --- Authentification ---
# Génère une chaîne aléatoire longue, ex: openssl rand -base64 32
JWT_SECRET="change-moi-en-une-chaine-secrete-longue-et-aleatoire"

# --- Cloudflare Stream ---
# Récupérés dans le dashboard Cloudflare (voir étapes données par Claude)
CLOUDFLARE_ACCOUNT_ID="ton-account-id-cloudflare"
CLOUDFLARE_API_TOKEN="ton-api-token-cloudflare"

# --- Stripe ---
# Récupérés dans le dashboard Stripe (mode test au démarrage)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"

# --- Divers ---
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Liste d'emails autorisés à uploader/gérer le catalogue (séparés par des virgules)
ADMIN_EMAILS="ton-email@exemple.com"
